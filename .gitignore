# ===== 모델 가중치 (Git 커밋 금지) =====
*.pt
*.pth
*.onnx
*.safetensors
*.bin
weights/*
!weights/.gitkeep
# 예외: 팀원이 직접 라벨링해서 학습한 YOLO 검출 모델(region_best.pt)과
# 한국어 인식 모델(korean_PP-OCRv5_rec_mobile.onnx, 공개 모델이지만 채점
# 서버가 오프라인이라 미리 있어야 함). 합쳐서 18MB. predict.ipynb가 이
# 경로를 그대로 로드하므로 빠지면 오프라인 채점에서 바로 실패한다.
!weights/region_best.pt
!weights/korean_PP-OCRv5_rec_mobile.onnx

# ===== 데이터 및 결과물 =====
images/
val_images/
*.zip
submission.csv
# 1차 OCR 스크리닝 작업물 (제출물 아님, 로컬 참고용)
ocr_screening/
# 팀 라벨링 작업물 (사진 포함, 제출물 아님, 로컬/구글드라이브 공유용)
labeling/

# ===== Python =====
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
# YOLO 학습 실험용 별도 가상환경 (제출물 아님, EasyOCR 메인 환경과 분리)
yolo_venv/
# YOLO 학습용으로 변환한 데이터셋(이미지 복사본+라벨 txt, 재생성 가능)과
# 학습 결과물(체크포인트/로그) — 제출물 아님, 코드(build_dataset.py 등)만 추적
yolo_train/dataset/
yolo_train/runs/
yolo_train/sample_preds/
yolo_train/*.pt

# ===== OS =====
.DS_Store
Thumbs.db
