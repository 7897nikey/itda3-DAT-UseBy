# ===== 모델 가중치 (Git 커밋 금지) =====
*.pt
*.pth
*.onnx
*.safetensors
*.bin
weights/*
!weights/.gitkeep
# 예외: 이건 외부에서 받는 사전학습 가중치가 아니라 우리 팀이 직접 라벨링한
# 450장으로 파인튜닝한 YOLO 모델(ONNX, 12MB) — 재생성 가능한 게 아니라서
# 커밋해서 추적한다. predict.ipynb가 이 경로를 그대로 로드함.
!weights/yolo_exp_mfg.onnx

# ===== 데이터 및 결과물 =====
images/
val_images/
*.zip
submission.csv
# 1차 OCR 스크리닝 작업물 (제출물 아님, 로컬 참고용)
ocr_screening/
# 팀 라벨링 작업물 (사진 포함, 제출물 아님, 로컬/구글드라이브 공유용)
labeling/

# ===== Python =====
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
# YOLO 학습 실험용 별도 가상환경 (제출물 아님, EasyOCR 메인 환경과 분리)
yolo_venv/
# YOLO 학습용으로 변환한 데이터셋(이미지 복사본+라벨 txt, 재생성 가능)과
# 학습 결과물(체크포인트/로그) — 제출물 아님, 코드(build_dataset.py 등)만 추적
yolo_train/dataset/
yolo_train/runs/
yolo_train/sample_preds/
yolo_train/*.pt

# ===== OS =====
.DS_Store
Thumbs.db

# ===== KGW_rapidocr 브랜치 추가분 =====
# 아래 둘도 재생성이 어렵거나 인터넷에서 받아야 하는 파일이라 커밋해서 추적함.
# alt_pipeline_rapidocr/predict.ipynb가 이 경로를 그대로 로드하므로,
# 빠지면 오프라인 채점에서 바로 실패함. (팀원 yolo_exp_mfg.onnx와 같은 이유)
!alt_pipeline_rapidocr/weights/
!alt_pipeline_rapidocr/weights/region_best.pt
!alt_pipeline_rapidocr/weights/korean_PP-OCRv5_rec_mobile.onnx
